// AutoPilot API — Prisma schema (MVP)
// Sources: domain-model, domain-decisions, database-model, erd, database-principles
// Audit package RECOMMENDED (A+B): Lead.convertedAt/firstResponseAt + recovery/dashboard indexes
// No migrations in this stage. Partial unique indexes deferred to custom SQL migrations.
//
// Field rules (application layer):
// - convertedAt: set when status becomes CONVERTED; never auto-cleared
// - firstResponseAt: set on first valid lead response; never recalculated

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums (approved MVP set)
// =============================================================================

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  RESPONDED
  QUALIFIED
  CONVERTED
  LOST
}

enum ConversationStatus {
  OPEN
  IDLE
  CLOSED
  ARCHIVED
}

enum Channel {
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum FollowUpStatus {
  SUGGESTED
  APPROVED
  REJECTED
  SCHEDULED
  EXECUTING
  EXECUTED
  FAILED
  CANCELLED
  SKIPPED
}

enum WhatsAppConnectionStatus {
  QR_PENDING
  CONNECTING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DUPLICATE
}

enum LeadActivityType {
  CALL
  MEETING
  EMAIL
  VISIT
  OTHER
}

enum LeadActivityStatus {
  PLANNED
  DONE
  CANCELLED
}

enum CompanyCurrency {
  BRL
  USD
  EUR
}

/// Fase 11A — AI Sales Agent mode (AUTO stored but unused until 11C).
enum AiAgentMode {
  OFF
  ASSIST
  AUTO
}

/// Fase 11A — Knowledge Base entry kinds.
enum KnowledgeBaseKind {
  FAQ
  PRODUCT
  PRICE
  PAYMENT
  DELIVERY
  HOURS
  ADDRESS
}

/// Fase 11A/11C — Intent classifier labels.
enum AiIntent {
  PRICE
  PRODUCT
  PAYMENT
  DELIVERY
  HOURS
  ADDRESS
  COMPLAINT
  HUMAN
  UNKNOWN
}

// =============================================================================
// Models
// =============================================================================

model Company {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @db.VarChar(200)
  slug          String?         @db.VarChar(100)
  status        CompanyStatus   @default(ACTIVE)
  timezone      String          @default("America/Sao_Paulo") @db.VarChar(64)
  plan          String?         @default("starter") @db.VarChar(32)
  locale        String          @default("pt-BR") @db.VarChar(16)
  businessHours Json?           @map("business_hours")
  logoUrl       String?         @map("logo_url") @db.VarChar(500)
  currency      CompanyCurrency @default(BRL)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)

  memberships           Membership[]
  leads                 Lead[]
  conversations         Conversation[]
  messages              Message[]
  followUps             FollowUp[]
  events                Event[]
  auditLogs             AuditLog[]
  sessions              Session[]
  refreshTokens         RefreshToken[]
  whatsappInstances     WhatsAppInstance[]
  webhookEvents         WebhookEvent[]
  leadNotes             LeadNote[]
  leadActivities        LeadActivity[]
  leadStatusTransitions LeadStatusTransition[]
  aiSettings            CompanyAiSettings?
  knowledgeBaseEntries  KnowledgeBaseEntry[]

  @@index([status])
  @@index([slug])
  @@map("companies")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String     @db.VarChar(200)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  memberships                  Membership[]           @relation("MembershipUser")
  membershipsInvited           Membership[]           @relation("MembershipInvitedBy")
  ownedLeads                   Lead[]                 @relation("LeadOwner")
  assignedConversations        Conversation[]         @relation("ConversationAssignee")
  sentMessages                 Message[]              @relation("MessageSender")
  assignedFollowUps            FollowUp[]             @relation("FollowUpAssignee")
  approvedFollowUps            FollowUp[]             @relation("FollowUpApprover")
  events                       Event[]                @relation("EventActor")
  auditLogs                    AuditLog[]             @relation("AuditActor")
  sessions                     Session[]
  refreshTokens                RefreshToken[]
  leadNotes                    LeadNote[]             @relation("LeadNoteAuthor")
  leadActivities               LeadActivity[]         @relation("LeadActivityAssignee")
  leadStatusTransitionsChanged LeadStatusTransition[] @relation("LeadStatusChangedBy")

  @@index([status])
  @@map("users")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  status    String         @default("INVITED") @db.VarChar(32)
  invitedBy String?        @map("invited_by") @db.Uuid
  joinedAt  DateTime?      @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company       Company @relation(fields: [companyId], references: [id])
  user          User    @relation("MembershipUser", fields: [userId], references: [id])
  invitedByUser User?   @relation("MembershipInvitedBy", fields: [invitedBy], references: [id])
  sessions      Session[]
  refreshTokens RefreshToken[]

  @@index([companyId])
  @@index([userId])
  @@index([companyId, userId])
  @@index([companyId, role])
  @@map("memberships")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid
  companyId    String?   @map("company_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip           String?   @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id])
  membership    Membership?    @relation(fields: [membershipId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([companyId])
  @@index([membershipId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid
  companyId    String?   @map("company_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  session    Session     @relation(fields: [sessionId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])
  company    Company?    @relation(fields: [companyId], references: [id])
  replacedBy RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  ownerId         String?    @map("owner_id") @db.Uuid
  name            String?    @db.VarChar(200)
  phone           String     @db.VarChar(32)
  email           String?    @db.VarChar(320)
  source          String     @default("WHATSAPP") @db.VarChar(32)
  status          LeadStatus @default(NEW)
  score           Int        @default(0)
  lastContactAt   DateTime?  @map("last_contact_at") @db.Timestamptz(6)
  lastInboundAt   DateTime?  @map("last_inbound_at") @db.Timestamptz(6)
  lastOutboundAt  DateTime?  @map("last_outbound_at") @db.Timestamptz(6)
  convertedAt     DateTime?  @map("converted_at") @db.Timestamptz(6)
  firstResponseAt DateTime?  @map("first_response_at") @db.Timestamptz(6)
  externalId      String?    @map("external_id") @db.VarChar(191)
  metadata        Json?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  company           Company                @relation(fields: [companyId], references: [id])
  owner             User?                  @relation("LeadOwner", fields: [ownerId], references: [id])
  conversations     Conversation[]
  followUps         FollowUp[]
  notes             LeadNote[]
  activities        LeadActivity[]
  statusTransitions LeadStatusTransition[]

  @@index([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([companyId, lastContactAt])
  @@index([companyId, lastInboundAt])
  @@index([companyId, score])
  @@index([companyId, createdAt])
  @@index([companyId, convertedAt])
  @@index([companyId, firstResponseAt])
  @@map("leads")
}

model LeadNote {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  leadId    String    @map("lead_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id])
  user    User    @relation("LeadNoteAuthor", fields: [userId], references: [id])

  @@index([companyId, leadId, createdAt])
  @@index([companyId, userId])
  @@map("lead_notes")
}

model LeadActivity {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  leadId      String             @map("lead_id") @db.Uuid
  userId      String?            @map("user_id") @db.Uuid
  type        LeadActivityType
  status      LeadActivityStatus @default(PLANNED)
  title       String             @db.VarChar(200)
  body        String?
  scheduledAt DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id])
  user    User?   @relation("LeadActivityAssignee", fields: [userId], references: [id])

  @@index([companyId, leadId, scheduledAt])
  @@index([companyId, status, scheduledAt])
  @@index([companyId, userId, status])
  @@map("lead_activities")
}

/// Append-only pipeline history (no soft delete). Used for avgTimeInStage / conversionByStage.
model LeadStatusTransition {
  id               String      @id @default(uuid()) @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  leadId           String      @map("lead_id") @db.Uuid
  fromStatus       LeadStatus? @map("from_status")
  toStatus         LeadStatus  @map("to_status")
  changedByUserId  String?     @map("changed_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id])
  lead      Lead    @relation(fields: [leadId], references: [id])
  changedBy User?   @relation("LeadStatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([companyId, leadId, createdAt])
  @@index([companyId, toStatus, createdAt])
  @@map("lead_status_transitions")
}

model Conversation {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  leadId           String             @map("lead_id") @db.Uuid
  channel          Channel            @default(WHATSAPP)
  status           ConversationStatus @default(OPEN)
  externalThreadId String?            @map("external_thread_id") @db.VarChar(191)
  lastMessageAt    DateTime?          @map("last_message_at") @db.Timestamptz(6)
  assignedUserId   String?            @map("assigned_user_id") @db.Uuid
  /// Fase 11C — when true, AUTO must not send until human resumes.
  agentPaused      Boolean            @default(false) @map("agent_paused")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)

  company      Company    @relation(fields: [companyId], references: [id])
  lead         Lead       @relation(fields: [leadId], references: [id])
  assignedUser User?      @relation("ConversationAssignee", fields: [assignedUserId], references: [id])
  messages     Message[]
  followUps    FollowUp[]

  @@index([companyId, leadId])
  @@index([companyId, status])
  @@index([companyId, lastMessageAt])
  @@index([companyId, channel, externalThreadId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  direction         MessageDirection
  status            String           @db.VarChar(32)
  body              String?
  contentType       String           @default("TEXT") @map("content_type") @db.VarChar(32)
  senderType        String           @map("sender_type") @db.VarChar(32)
  senderUserId      String?          @map("sender_user_id") @db.Uuid
  externalMessageId String?          @map("external_message_id") @db.VarChar(191)
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?        @map("delivered_at") @db.Timestamptz(6)
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  /// Set when outbound reaches FAILED (P3); never delete FAILED rows (P3-D1)
  failedAt          DateTime?        @map("failed_at") @db.Timestamptz(6)
  errorMessage      String?          @map("error_message") @db.VarChar(1000)
  metadata          Json?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  company         Company      @relation(fields: [companyId], references: [id])
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderUser      User?        @relation("MessageSender", fields: [senderUserId], references: [id])
  followUpResults FollowUp[]   @relation("FollowUpResultMessage")

  @@index([conversationId, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, externalMessageId])
  @@index([companyId, direction, status])
  @@map("messages")
}

model FollowUp {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  leadId          String         @map("lead_id") @db.Uuid
  conversationId  String?        @map("conversation_id") @db.Uuid
  assignedUserId  String?        @map("assigned_user_id") @db.Uuid
  approvedBy      String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  channel         Channel        @default(WHATSAPP)
  status          FollowUpStatus @default(SUGGESTED)
  type            String         @default("RECOVERY") @db.VarChar(32)
  scheduledAt     DateTime?      @map("scheduled_at") @db.Timestamptz(6)
  executedAt      DateTime?      @map("executed_at") @db.Timestamptz(6)
  suggestedBody   String?        @map("suggested_body")
  resultMessageId String?        @map("result_message_id") @db.Uuid
  cancelReason    String?        @map("cancel_reason") @db.VarChar(500)
  /// Phase 4: { attemptCount } for retry limits (P4-R4)
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company        Company       @relation(fields: [companyId], references: [id])
  lead           Lead          @relation(fields: [leadId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  assignedUser   User?         @relation("FollowUpAssignee", fields: [assignedUserId], references: [id])
  approvedByUser User?         @relation("FollowUpApprover", fields: [approvedBy], references: [id])
  resultMessage  Message?      @relation("FollowUpResultMessage", fields: [resultMessageId], references: [id])

  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@index([companyId, executedAt])
  @@index([companyId, leadId])
  @@map("follow_ups")
}

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String?   @map("company_id") @db.Uuid
  type          String    @db.VarChar(120)
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @default("{}")
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  correlationId String?   @map("correlation_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  status        String    @default("PENDING") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company? @relation(fields: [companyId], references: [id])
  actorUser User?    @relation("EventActor", fields: [actorUserId], references: [id])

  @@index([companyId, occurredAt])
  @@index([companyId, type])
  @@index([aggregateType, aggregateId])
  @@index([status])
  @@map("events")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  actorType   String    @map("actor_type") @db.VarChar(32)
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(120)
  targetType  String    @map("target_type") @db.VarChar(64)
  targetId    String    @map("target_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id])
  actorUser User?   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([companyId, occurredAt])
  @@index([companyId, action])
  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model WhatsAppInstance {
  id                    String                    @id @default(uuid()) @db.Uuid
  companyId             String                    @map("company_id") @db.Uuid
  /// Public webhook path key (D11: UUID)
  instanceKey           String                    @unique @map("instance_key") @db.Uuid
  evolutionInstanceName String                    @unique @map("evolution_instance_name") @db.VarChar(100)
  evolutionInstanceId   String?                   @map("evolution_instance_id") @db.VarChar(191)
  status                WhatsAppConnectionStatus
  phoneNumber           String?                   @map("phone_number") @db.VarChar(32)
  /// Argon2 hash of 64-byte webhook secret (D12)
  webhookSecretHash     String                    @map("webhook_secret_hash") @db.VarChar(255)
  qrCode                String?                   @map("qr_code")
  qrExpiresAt           DateTime?                 @map("qr_expires_at") @db.Timestamptz(6)
  connectedAt           DateTime?                 @map("connected_at") @db.Timestamptz(6)
  lastDisconnectedAt    DateTime?                 @map("last_disconnected_at") @db.Timestamptz(6)
  lastError             String?                   @map("last_error") @db.VarChar(1000)
  metadata              Json?
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?                 @map("deleted_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id])
  webhookEvents WebhookEvent[]

  @@index([companyId])
  @@index([status])
  @@map("whatsapp_instances")
}

/// Raw Evolution webhook log (D5 / P2-W1). Append-oriented.
model WebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  instanceId      String             @map("instance_id") @db.Uuid
  /// Provider event id when available — partial unique for event-level idempotency
  externalEventId String?            @map("external_event_id") @db.VarChar(191)
  eventType       String             @map("event_type") @db.VarChar(120)
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  error           String?            @db.VarChar(1000)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)

  company  Company          @relation(fields: [companyId], references: [id])
  instance WhatsAppInstance @relation(fields: [instanceId], references: [id])

  @@index([companyId, receivedAt])
  @@index([companyId, status])
  @@index([instanceId, receivedAt])
  @@index([companyId, externalEventId])
  @@map("webhook_events")
}

/// Fase 11A — per-company AI agent settings (1:1).
model CompanyAiSettings {
  id                       String      @id @default(uuid()) @db.Uuid
  companyId                String      @unique @map("company_id") @db.Uuid
  mode                     AiAgentMode @default(ASSIST)
  /// Cap of AUTO outbounds per lead per day (11C guardrail).
  maxAutoRepliesPerLeadDay Int         @default(3) @map("max_auto_replies_per_lead_day")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?   @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_ai_settings")
}

/// Fase 11A — tenant Knowledge Base entries for grounding.
model KnowledgeBaseEntry {
  id        String             @id @default(uuid()) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  kind      KnowledgeBaseKind
  title     String             @db.VarChar(200)
  body      String             @db.VarChar(8000)
  tags      String[]           @default([])
  active    Boolean            @default(true)
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, kind])
  @@index([companyId, active])
  @@index([companyId, sortOrder])
  @@map("knowledge_base_entries")
}
