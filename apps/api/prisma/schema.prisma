// AutoPilot API — Prisma schema (MVP)
// Sources: domain-model, domain-decisions, database-model, erd, database-principles
// Audit package RECOMMENDED (A+B): Lead.convertedAt/firstResponseAt + recovery/dashboard indexes
// No migrations in this stage. Partial unique indexes deferred to custom SQL migrations.
//
// Field rules (application layer):
// - convertedAt: set when status becomes CONVERTED; never auto-cleared
// - firstResponseAt: set on first valid lead response; never recalculated

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums (approved MVP set)
// =============================================================================

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  RESPONDED
  QUALIFIED
  CONVERTED
  LOST
}

enum ConversationStatus {
  OPEN
  IDLE
  CLOSED
  ARCHIVED
}

enum Channel {
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum FollowUpStatus {
  SUGGESTED
  APPROVED
  REJECTED
  SCHEDULED
  EXECUTING
  EXECUTED
  FAILED
  CANCELLED
  SKIPPED
}

// =============================================================================
// Models
// =============================================================================

model Company {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(200)
  slug      String?       @db.VarChar(100)
  status    CompanyStatus @default(ACTIVE)
  timezone  String        @default("America/Sao_Paulo") @db.VarChar(64)
  plan      String?       @default("starter") @db.VarChar(32)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  memberships   Membership[]
  leads         Lead[]
  conversations Conversation[]
  messages      Message[]
  followUps     FollowUp[]
  events        Event[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([slug])
  @@map("companies")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String     @db.VarChar(200)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  memberships           Membership[]   @relation("MembershipUser")
  membershipsInvited    Membership[]   @relation("MembershipInvitedBy")
  ownedLeads            Lead[]         @relation("LeadOwner")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages          Message[]      @relation("MessageSender")
  assignedFollowUps     FollowUp[]     @relation("FollowUpAssignee")
  approvedFollowUps     FollowUp[]     @relation("FollowUpApprover")
  events                Event[]        @relation("EventActor")
  auditLogs             AuditLog[]     @relation("AuditActor")

  @@index([status])
  @@map("users")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  status    String         @default("INVITED") @db.VarChar(32)
  invitedBy String?        @map("invited_by") @db.Uuid
  joinedAt  DateTime?      @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company       Company @relation(fields: [companyId], references: [id])
  user          User    @relation("MembershipUser", fields: [userId], references: [id])
  invitedByUser User?   @relation("MembershipInvitedBy", fields: [invitedBy], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([companyId, userId])
  @@index([companyId, role])
  @@map("memberships")
}

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  ownerId         String?    @map("owner_id") @db.Uuid
  name            String?    @db.VarChar(200)
  phone           String     @db.VarChar(32)
  email           String?    @db.VarChar(320)
  source          String     @default("WHATSAPP") @db.VarChar(32)
  status          LeadStatus @default(NEW)
  score           Int        @default(0)
  lastContactAt   DateTime?  @map("last_contact_at") @db.Timestamptz(6)
  lastInboundAt   DateTime?  @map("last_inbound_at") @db.Timestamptz(6)
  lastOutboundAt  DateTime?  @map("last_outbound_at") @db.Timestamptz(6)
  convertedAt     DateTime?  @map("converted_at") @db.Timestamptz(6)
  firstResponseAt DateTime?  @map("first_response_at") @db.Timestamptz(6)
  externalId      String?    @map("external_id") @db.VarChar(191)
  metadata        Json?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id])
  owner         User?          @relation("LeadOwner", fields: [ownerId], references: [id])
  conversations Conversation[]
  followUps     FollowUp[]

  @@index([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([companyId, lastContactAt])
  @@index([companyId, lastInboundAt])
  @@index([companyId, score])
  @@index([companyId, createdAt])
  @@index([companyId, convertedAt])
  @@index([companyId, firstResponseAt])
  @@map("leads")
}

model Conversation {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  leadId           String             @map("lead_id") @db.Uuid
  channel          Channel            @default(WHATSAPP)
  status           ConversationStatus @default(OPEN)
  externalThreadId String?            @map("external_thread_id") @db.VarChar(191)
  lastMessageAt    DateTime?          @map("last_message_at") @db.Timestamptz(6)
  assignedUserId   String?            @map("assigned_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)

  company      Company    @relation(fields: [companyId], references: [id])
  lead         Lead       @relation(fields: [leadId], references: [id])
  assignedUser User?      @relation("ConversationAssignee", fields: [assignedUserId], references: [id])
  messages     Message[]
  followUps    FollowUp[]

  @@index([companyId, leadId])
  @@index([companyId, status])
  @@index([companyId, lastMessageAt])
  @@index([companyId, channel, externalThreadId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  direction         MessageDirection
  status            String           @db.VarChar(32)
  body              String?
  contentType       String           @default("TEXT") @map("content_type") @db.VarChar(32)
  senderType        String           @map("sender_type") @db.VarChar(32)
  senderUserId      String?          @map("sender_user_id") @db.Uuid
  externalMessageId String?          @map("external_message_id") @db.VarChar(191)
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?        @map("delivered_at") @db.Timestamptz(6)
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  metadata          Json?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)

  company         Company      @relation(fields: [companyId], references: [id])
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderUser      User?        @relation("MessageSender", fields: [senderUserId], references: [id])
  followUpResults FollowUp[]   @relation("FollowUpResultMessage")

  @@index([conversationId, createdAt])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, externalMessageId])
  @@map("messages")
}

model FollowUp {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  leadId          String         @map("lead_id") @db.Uuid
  conversationId  String?        @map("conversation_id") @db.Uuid
  assignedUserId  String?        @map("assigned_user_id") @db.Uuid
  approvedBy      String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  channel         Channel        @default(WHATSAPP)
  status          FollowUpStatus @default(SUGGESTED)
  type            String         @default("RECOVERY") @db.VarChar(32)
  scheduledAt     DateTime?      @map("scheduled_at") @db.Timestamptz(6)
  executedAt      DateTime?      @map("executed_at") @db.Timestamptz(6)
  suggestedBody   String?        @map("suggested_body")
  resultMessageId String?        @map("result_message_id") @db.Uuid
  cancelReason    String?        @map("cancel_reason") @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company        Company       @relation(fields: [companyId], references: [id])
  lead           Lead          @relation(fields: [leadId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  assignedUser   User?         @relation("FollowUpAssignee", fields: [assignedUserId], references: [id])
  approvedByUser User?         @relation("FollowUpApprover", fields: [approvedBy], references: [id])
  resultMessage  Message?      @relation("FollowUpResultMessage", fields: [resultMessageId], references: [id])

  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@index([companyId, executedAt])
  @@index([companyId, leadId])
  @@map("follow_ups")
}

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String?   @map("company_id") @db.Uuid
  type          String    @db.VarChar(120)
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @default("{}")
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  correlationId String?   @map("correlation_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  status        String    @default("PENDING") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company? @relation(fields: [companyId], references: [id])
  actorUser User?    @relation("EventActor", fields: [actorUserId], references: [id])

  @@index([companyId, occurredAt])
  @@index([companyId, type])
  @@index([aggregateType, aggregateId])
  @@index([status])
  @@map("events")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  actorType   String    @map("actor_type") @db.VarChar(32)
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(120)
  targetType  String    @map("target_type") @db.VarChar(64)
  targetId    String    @map("target_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id])
  actorUser User?   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([companyId, occurredAt])
  @@index([companyId, action])
  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("audit_logs")
}
