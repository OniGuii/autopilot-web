NODE_ENV=development
PORT=3001
API_PREFIX=api
# Default: on in development, off in production (unless explicitly true)
SWAGGER_ENABLED=true
# Required when Swagger is enabled in production
SWAGGER_USER=
SWAGGER_PASSWORD=

# Global rate limit (per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=20

DATABASE_URL=postgresql://autopilot:autopilot@localhost:5432/autopilot?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Channel Hardening (6B)
EVOLUTION_TIMEOUT_SEND_MS=15000
EVOLUTION_TIMEOUT_CONNECT_MS=20000
EVOLUTION_TIMEOUT_DEFAULT_MS=10000
EVOLUTION_RETRY_MAX=2
EVOLUTION_CONNECT_COOLDOWN_MS=10000
EVOLUTION_CB_ENABLED=true
EVOLUTION_CB_FAILURE_THRESHOLD=5
EVOLUTION_CB_OPEN_MS=30000
WEBHOOK_SLOW_MS=2000
WEBHOOK_MAX_INFLIGHT=50
OPS_RECONCILE_TAKE=100

# Fase 7.1 / 7.1-H — Async Foundation (inbound queue). Default off = sync webhook.
ASYNC_INBOUND_ENABLED=false
ASYNC_WORKERS_IN_API=true
ASYNC_INBOUND_ATTEMPTS=5
ASYNC_INBOUND_BACKOFF_MS=2000
QUEUE_CONCURRENCY=10
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000
QUEUE_DLQ_MAX_JOBS=1000
QUEUE_DLQ_RETENTION_MS=604800000
QUEUE_DLQ_STALE_MS=3600000
WEBHOOK_CLAIM_STALE_MS=45000
WEBHOOK_RECEIVED_STALE_MS=300000

# Fase 7.2A — FollowUp scheduler worker. Default off = manual execute only.
ASYNC_FOLLOWUP_ENABLED=false
FOLLOWUP_SCHEDULER_ATTEMPTS=3
FOLLOWUP_SCHEDULER_BACKOFF_MS=5000
FOLLOWUP_SCHEDULER_CONCURRENCY=5
FOLLOWUP_SCHEDULER_SCAN_INTERVAL_MS=30000
FOLLOWUP_SCHEDULER_SCAN_BATCH=50
FOLLOWUP_SCHEDULER_BACKLOG_HIGH=100

# Fase 7.2B — Reconcile worker. Default off.
ASYNC_RECONCILE_ENABLED=false
RECONCILE_ATTEMPTS=2
RECONCILE_BACKOFF_MS=30000
RECONCILE_CONCURRENCY=1
RECONCILE_SCAN_INTERVAL_MS=300000
RECONCILE_TAKE=100

# Fase 7.2C — AI suggestion worker. Default off = sync POST /ai/.../suggest.
ASYNC_AI_ENABLED=false
AI_SUGGEST_ATTEMPTS=3
AI_SUGGEST_BACKOFF_MS=3000
AI_SUGGEST_CONCURRENCY=2
AI_SUGGEST_TIMEOUT_MS=25000
AI_SUGGEST_LOCK_DURATION_MS=90000
AI_SUGGEST_BACKLOG_HIGH=50
AI_FAILURE_RATE_MIN_SAMPLES=10
AI_FAILURE_RATE_THRESHOLD=0.5

# Fase 8A — Observability Foundation
OTEL_ENABLED=false
OTEL_SERVICE_NAME=autopilot-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
# LOG_FORMAT=json|pretty (default: json in production, pretty otherwise)
OBS_PRISMA_SLOW_MS=500
OBS_HIGH_ERROR_RATE_THRESHOLD=0.05
OBS_HIGH_LATENCY_MS=2000
OBS_QUEUE_BACKLOG_HIGH=100
OBS_HTTP_ERROR_MIN_SAMPLES=20
# 8B — DB health Ops alerts
OBS_SLOW_QUERY_ALERT_MIN=5
OBS_FULL_TABLE_SCAN_SEQ_MIN=1000
OBS_FULL_TABLE_SCAN_RATIO=10

API_PUBLIC_URL=http://localhost:3001

# Required outside NODE_ENV=test (min 32 chars). Never use the old insecure default.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

