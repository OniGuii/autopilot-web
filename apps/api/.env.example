NODE_ENV=development
PORT=3001
API_PREFIX=api
# Default: on in development, off in production (unless explicitly true)
SWAGGER_ENABLED=true
# Required when Swagger is enabled in production
SWAGGER_USER=
SWAGGER_PASSWORD=

# Global rate limit (per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=20

DATABASE_URL=postgresql://autopilot:autopilot@localhost:5432/autopilot?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Channel Hardening (6B)
EVOLUTION_TIMEOUT_SEND_MS=15000
EVOLUTION_TIMEOUT_CONNECT_MS=20000
EVOLUTION_TIMEOUT_DEFAULT_MS=10000
EVOLUTION_RETRY_MAX=2
EVOLUTION_CONNECT_COOLDOWN_MS=10000
EVOLUTION_CB_ENABLED=true
EVOLUTION_CB_FAILURE_THRESHOLD=5
EVOLUTION_CB_OPEN_MS=30000
WEBHOOK_SLOW_MS=2000
WEBHOOK_MAX_INFLIGHT=50
OPS_RECONCILE_TAKE=100

# Fase 7.1 — Async Foundation (inbound queue). Default off = sync webhook.
ASYNC_INBOUND_ENABLED=false
ASYNC_WORKERS_IN_API=true
ASYNC_INBOUND_ATTEMPTS=5
ASYNC_INBOUND_BACKOFF_MS=2000
ASYNC_INBOUND_CONCURRENCY=10

API_PUBLIC_URL=http://localhost:3001

# Required outside NODE_ENV=test (min 32 chars). Never use the old insecure default.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

