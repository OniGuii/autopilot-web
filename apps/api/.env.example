NODE_ENV=development
PORT=3001
API_PREFIX=api
# Default: on in development, off in production (unless explicitly true)
SWAGGER_ENABLED=true
# Required when Swagger is enabled in production
SWAGGER_USER=
SWAGGER_PASSWORD=

# Global rate limit (per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=20

DATABASE_URL=postgresql://autopilot:autopilot@localhost:5432/autopilot?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

API_PUBLIC_URL=http://localhost:3001

# Required outside NODE_ENV=test (min 32 chars). Never use the old insecure default.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

